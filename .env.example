# Copy to .env.local for local `vercel dev`. Never commit .env.local.
# Use the same variable names in Vercel Project Settings → Environment Variables.

JSONBIN_API_BASE_URL=https://api.jsonbin.io/v3/b
JSONBIN_NOTES_BIN_ID=replace_with_notes_bin_id
JSONBIN_FILES_BIN_ID=replace_with_dedicated_files_bin_id
JSONBIN_API_KEY=replace_with_a_rotated_jsonbin_access_key
JSONBIN_KEY_HEADER=X-Access-Key
APP_WRITE_TOKEN=replace_with_a_long_random_write_token
MAX_FILE_BYTES=262144

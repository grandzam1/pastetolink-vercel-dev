# Copy to .env.local. It is ignored by Git and never served to browsers.
# Local development uses a SQLite file. For production, replace this with a Turso URL
# such as libsql://your-database-your-org.turso.io and set TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:./data/pastetolink.db
TURSO_AUTH_TOKEN=
# Optional: set a long random token to require Bearer auth for writes.
# Leave empty to allow unauthenticated writes (public file API stays public either way).
APP_WRITE_TOKEN=
MAX_FILE_BYTES=262144
